    {
      "name": "03 - Demostracion ESCRITURA (cambia datos del VPS)",
      "description": "OPCIONAL: ejecutar manualmente y en orden solo en horario de pruebas coordinadas. 12 aumenta el stock +1; 13 lo restaura. No ejecutar con operaciones concurrentes: sobrescribir stock podría perder cambios ajenos. No ejecutar de forma accidental desde Collection Runner.",
      "item": [
        {
          "name": "12 Ajustar stock +1 | 200 (MODIFICA)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/productos/{{productoId}}/stock",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "productos",
                "{{productoId}}",
                "stock"
              ]
            },
            "description": "Antes ejecutar GET inventario 02; la petición establece stockOriginal+1. Luego ejecutar 13 para restaurar. Pre-request construye JSON numérico.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stock\": \"{{stockNuevo}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const orig=pm.collectionVariables.get('stockOriginal');",
                  "if(orig === undefined || orig === null || orig === ''){throw new Error('Primero ejecutar 02 Inventario para capturar stockOriginal');}",
                  "const nuevo=Number(orig)+1;",
                  "pm.collectionVariables.set('stockNuevo',String(nuevo));",
                  "pm.request.body.update(JSON.stringify({stock:nuevo}));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200 - stock actualizado',()=>pm.response.to.have.status(200));",
                  "const p=pm.response.json();",
                  "pm.test('Stock resulta igual al nuevo',()=>pm.expect(p.stock).to.eql(Number(pm.collectionVariables.get('stockNuevo'))));"
                ]
              }
            }
          ]
        },
        {
          "name": "13 Restaurar stock anterior | 200 (MODIFICA)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/productos/{{productoId}}/stock",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "productos",
                "{{productoId}}",
                "stock"
              ]
            },
            "description": "Ejecutar solo después del paso 12, verificando ausencia de compras/concurrencia. Pre-request construye JSON numérico.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stock\": \"{{stockOriginal}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const orig=pm.collectionVariables.get('stockOriginal');",
                  "if(orig === undefined || orig === null || orig === ''){throw new Error('Primero ejecutar 02 Inventario para capturar stockOriginal');}",
                  "pm.request.body.update(JSON.stringify({stock:Number(orig)}));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200 - stock restaurado',()=>pm.response.to.have.status(200));",
                  "const p=pm.response.json();",
                  "pm.test('Stock restaurado al valor inicial',()=>pm.expect(p.stock).to.eql(Number(pm.collectionVariables.get('stockOriginal'))));"
                ]
              }
            }
          ]
        },
        {
          "name": "14 Crear pedido válido | 201 (PERMANENTE, OPCIONAL)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/pedidos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pedidos"
              ]
            },
            "description": "ATENCIÓN: inserta pedido permanente y descuenta stock real del VPS. Solo con autorización del equipo; no usar para captura básica. El costo de envío en el backend actual es 10000, cuestión funcional pendiente.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"direccion\": \"Av. Pruebas 123, Lima\",\n  \"referencia\": \"Evidencia Postman - registrar como prueba\",\n  \"metodoPago\": \"EFECTIVO\",\n  \"detalles\": [\n    {\n      \"productoId\": 4,\n      \"cantidad\": 1\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const id=Number(pm.collectionVariables.get('productoId')||4);",
                  "pm.request.body.update(JSON.stringify({direccion:'Av. Pruebas 123, Lima',referencia:'Evidencia Postman',metodoPago:'EFECTIVO',detalles:[{productoId:id,cantidad:1}]}));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201 - pedido creado',()=>pm.response.to.have.status(201));",
                  "const p=pm.response.json();",
                  "pm.test('Pedido tiene id, total y detalles',()=>{",
                  "  pm.expect(p.id).to.be.a('number');",
                  "  pm.expect(p.detalles).to.be.an('array').that.is.not.empty;",
                  "});",
                  "pm.collectionVariables.set('pedidoCreadoId',String(p.id));",
                  "console.log('Nuevo pedido:',p.id);"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
