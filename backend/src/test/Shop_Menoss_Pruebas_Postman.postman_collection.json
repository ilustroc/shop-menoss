      "name": "01 - Consultas (NO modifican datos)",
      "description": "Ejecutar primero. Los tests capturan el ID y stock inicial de un producto, y el ID de un pedido existente para pruebas sucesivas.",
      "item": [
        {
          "name": "01 Salud de API | 200",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200 - salud', () => pm.response.to.have.status(200));",
                  "pm.test('Mensaje correcto', () => pm.expect(pm.response.text()).to.include('Shop Menoss API funcionando correctamente'));"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Inventario completo | 200",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/inventario",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "inventario"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200 - inventario', () => pm.response.to.have.status(200));",
                  "const a=pm.response.json();",
                  "pm.test('Respuesta es una lista',()=>pm.expect(a).to.be.an('array'));",
                  "pm.test('Campos y consistencia stockBajo (<=5)',()=>{",
                  "  a.forEach(p=>{",
                  "    pm.expect(p).to.have.all.keys('productoId','nombre','stock','stockBajo');",
                  "    pm.expect(p.stock).to.be.a('number');",
                  "    pm.expect(p.stockBajo).to.eql(p.stock <= 5);",
                  "  });",
                  "});",
                  "const p=a.find(x=>x.productoId===4) || a.find(x=>Number.isInteger(x.stock) && x.stock >= 0);",
                  "if(p){",
                  "  pm.collectionVariables.set('productoId',String(p.productoId));",
                  "  pm.collectionVariables.set('stockOriginal',String(p.stock));",
                  "  pm.collectionVariables.set('stockNuevo',String(p.stock+1));",
                  "  console.log('Producto elegido:',p.productoId,p.nombre,'stock base',p.stock);",
                  "}"
                ]
              }
            }
          ]
        },
