                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/pedidos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pedidos"
              ]
            },
            "description": "El @Transactional revierte modificaciones al rechazarse el pedido. Postman debe sustituir productoId como número JSON; se genera body mediante script antes de enviar.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"direccion\": \"Av. Test 123, Lima\",\n  \"referencia\": \"Caso negativo de Postman\",\n  \"metodoPago\": \"EFECTIVO\",\n  \"detalles\": [\n    {\n      \"productoId\": \"{{productoId}}\",\n      \"cantidad\": 1000000000\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const id=Number(pm.collectionVariables.get('productoId')||4);",
                  "pm.request.body.update(JSON.stringify({direccion:'Av. Test 123, Lima',referencia:'Caso negativo Postman',metodoPago:'EFECTIVO',detalles:[{productoId:id,cantidad:1000000000}]}));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 409 - stock insuficiente',()=>pm.response.to.have.status(409));",
                  "pm.test('Explica insuficiencia de stock',()=>pm.expect(pm.response.json().error.toLowerCase()).to.include('stock insuficiente'));"
                ]
              }
            }
          ]
        },
