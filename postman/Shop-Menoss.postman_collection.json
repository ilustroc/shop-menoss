            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Producto Demo Postman\",\n  \"descripcion\": \"Creado durante la demostración académica\",\n  \"precio\": 9.90,\n  \"stock\": 7,\n  \"imagenUrl\": null,\n  \"activo\": true,\n  \"categoriaId\": 0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.collectionVariables.get('enableProfessorDemo') !== 'true') {",
                  "  console.warn('Omitida: define enableProfessorDemo=true sólo durante la demostración.');",
                  "  pm.execution.skipRequest();",
                  "} else {",
                  "  const categoriaId = pm.collectionVariables.get('categoriaId');",
                  "  if (!categoriaId) throw new Error('Ejecuta primero 19 Consultar categorías.');",
                  "  const nombre = `Producto Demo Postman ${Date.now()}`;",
                  "  pm.collectionVariables.set('productoDemoNombre', nombre);",
                  "  pm.request.body.update(JSON.stringify({nombre,descripcion:'Creado durante la demostración académica',precio:9.90,stock:7,imagenUrl:null,activo:true,categoriaId:Number(categoriaId)}));",
                  "}"
                ]
              }
            },
