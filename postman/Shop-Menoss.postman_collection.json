            "description": "Restaura el valor capturado. Sólo es seguro si no hubo cambios concurrentes.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stock\": \"{{stockOriginal}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.collectionVariables.get('enableStockWrite') !== 'true' || pm.collectionVariables.get('stockWritePendingRestore') !== 'true') {",
                  "  console.warn('Omitida: no hay cambio pendiente de restaurar.');",
                  "  pm.execution.skipRequest();",
                  "} else {",
                  "  pm.request.body.update(JSON.stringify({stock:Number(pm.collectionVariables.get('stockOriginal'))}));",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200 - stock restaurado',()=>pm.response.to.have.status(200));",
                  "const p=pm.response.json();",
                  "pm.test('Stock restaurado al valor inicial',()=>pm.expect(p.stock).to.eql(Number(pm.collectionVariables.get('stockOriginal'))));",
                  "if (pm.response.code === 200) { pm.collectionVariables.set('stockWritePendingRestore','false'); pm.collectionVariables.set('enableStockWrite','false'); }"
                ]
              }
            }
          ]
        },
