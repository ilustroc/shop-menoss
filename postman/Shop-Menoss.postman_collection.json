                ]
              }
            }
          ]
        },
        {
          "name": "12 Pedido sin stock suficiente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/pedidos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pedidos"
              ]
            },
            "description": "Solicita stockOriginal + 1. @Transactional revierte el descuento al responder 409.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"direccion\": \"Av. Test 123, Lima\",\n  \"referencia\": \"Caso negativo de Postman\",\n  \"metodoPago\": \"EFECTIVO\",\n  \"detalles\": [\n    {\n      \"productoId\": \"{{productoId}}\",\n      \"cantidad\": 1000000000\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const id = pm.collectionVariables.get('productoId');",
                  "const stock = Number(pm.collectionVariables.get('stockOriginal'));",
                  "if (!id || !Number.isInteger(stock) || stock >= 2147483647) {",
                  "  console.warn('Omitida: falta producto apto.');",
                  "  pm.execution.skipRequest();",
                  "} else {",
                  "  pm.request.body.update(JSON.stringify({direccion:'Av. Pruebas 123, Lima',referencia:'Stock insuficiente',metodoPago:'EFECTIVO',detalles:[{productoId:Number(id),cantidad:stock+1}]}));",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 409', () => pm.response.to.have.status(409));",
                  "pm.test('Error informa stock insuficiente', () => pm.expect(pm.response.json().error).to.include('Stock insuficiente'));"
                ]
              }
            }
          ]
        },
