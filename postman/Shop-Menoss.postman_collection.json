            "description": "Usa pedidoId capturado por el listado. Se omite si no existen pedidos."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('pedidoId')) {",
                  "  console.warn('Omitida: no existen pedidos para consultar.');",
                  "  pm.execution.skipRequest();",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const pedido = pm.response.json();",
                  "pm.test('Pedido coincide y contiene campos relevantes', () => {",
                  "  pm.expect(String(pedido.id)).to.eql(pm.collectionVariables.get('pedidoId'));",
                  "  pm.expect(pedido).to.include.all.keys('direccion','metodoPago','subtotal','envio','total','fechaCreacion','detalles');",
                  "  pm.expect(pedido.detalles).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
