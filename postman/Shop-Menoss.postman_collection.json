          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Mensaje de salud esperado', () => pm.expect(pm.response.text()).to.eql('Shop Menoss API funcionando correctamente'));"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Inventario completo",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/inventario",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "inventario"
              ]
            },
            "description": "Lista el inventario y captura un producto, su stock y un ID inexistente calculado."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const productos = pm.response.json();",
                  "pm.test('Respuesta es una lista', () => pm.expect(productos).to.be.an('array'));",
                  "pm.test('Campos y criterio stockBajo', () => productos.forEach(p => {",
                  "  pm.expect(p).to.have.all.keys('productoId','nombre','stock','stockBajo');",
                  "  pm.expect(p.productoId).to.be.a('number');",
                  "  pm.expect(p.nombre).to.be.a('string');",
                  "  pm.expect(p.stock).to.be.a('number');",
                  "  pm.expect(p.stockBajo).to.eql(p.stock <= 5);",
                  "}));",
                  "if (productos.length) {",
                  "  const producto = productos[0];",
                  "  const conStock = productos.find(p => Number.isInteger(p.stock) && p.stock > 0);",
                  "  pm.collectionVariables.set('productoId', String(producto.productoId));",
                  "  pm.collectionVariables.set('stockOriginal', String(producto.stock));",
                  "  pm.collectionVariables.set('stockNuevo', String(producto.stock + 1));",
                  "  pm.collectionVariables.set('productoInexistenteId', String(Math.max(...productos.map(p => Number(p.productoId))) + 1000000));",
                  "  if (conStock) pm.collectionVariables.set('productoConStockId', String(conStock.productoId));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "03 Productos con stock bajo",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/inventario/bajo-stock",
              "host": [
