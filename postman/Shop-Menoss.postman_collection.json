              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const id = pm.collectionVariables.get('productoId');",
                  "if (!id) { pm.execution.skipRequest(); } else {",
                  "  pm.request.body.update(JSON.stringify({direccion:'Av. Pruebas 123, Lima',referencia:'Cantidad inválida',metodoPago:'EFECTIVO',detalles:[{productoId:Number(id),cantidad:0}]}));",
