                  "pm.test('Producto creado con campos y valores esperados', () => {",
                  "  pm.expect(producto).to.include.all.keys('id','nombre','descripcion','precio','stock','imagenUrl','activo','categoriaId','categoriaNombre');",
                  "  pm.expect(producto.id).to.be.a('number');",
                  "  pm.expect(producto.nombre).to.eql(pm.collectionVariables.get('productoDemoNombre'));",
                  "  pm.expect(producto.precio).to.eql(9.9);",
                  "  pm.expect(producto.stock).to.eql(7);",
                  "  pm.expect(producto.activo).to.eql(true);",
                  "  pm.expect(String(producto.categoriaId)).to.eql(pm.collectionVariables.get('categoriaId'));",
                  "});",
                  "if (producto.id) pm.collectionVariables.set('productoDemoId', String(producto.id));",
                  "pm.collectionVariables.set('enableProfessorDemo', 'false');"
                ]
              }
