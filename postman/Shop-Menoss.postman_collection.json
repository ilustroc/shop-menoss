    {
      "name": "03 - Operaciones de escritura",
      "description": "Se omiten por defecto. enableStockWrite habilita el cambio temporal y su restauración; enablePermanentWrites habilita pedidos y usuarios permanentes.",
      "item": [
        {
          "name": "15 Actualización válida de stock (MODIFICA)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/productos/{{productoId}}/stock",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "productos",
                "{{productoId}}",
                "stock"
              ]
            },
            "description": "Establece stockOriginal + 1. Requiere enableStockWrite=true y restauración inmediata.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stock\": \"{{stockNuevo}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.collectionVariables.get('enableStockWrite') !== 'true') {",
                  "  console.warn('Omitida: define enableStockWrite=true conscientemente.');",
                  "  pm.execution.skipRequest();",
                  "} else {",
                  "  const original = Number(pm.collectionVariables.get('stockOriginal'));",
                  "  if (!pm.collectionVariables.get('productoId') || !Number.isInteger(original)) throw new Error('Ejecuta primero Inventario completo.');",
                  "  const nuevo = original + 1;",
                  "  pm.collectionVariables.set('stockNuevo', String(nuevo));",
                  "  pm.request.body.update(JSON.stringify({stock:nuevo}));",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200 - stock actualizado',()=>pm.response.to.have.status(200));",
                  "const p=pm.response.json();",
                  "pm.test('Stock resulta igual al nuevo',()=>pm.expect(p.stock).to.eql(Number(pm.collectionVariables.get('stockNuevo'))));",
                  "if (pm.response.code === 200) pm.collectionVariables.set('stockWritePendingRestore', 'true');"
                ]
              }
            }
          ]
        },
