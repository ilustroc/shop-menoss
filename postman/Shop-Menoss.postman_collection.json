            "description": "Devuelve productos con stock menor o igual al umbral implementado de 5."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200 - stock bajo',()=>pm.response.to.have.status(200));",
                  "const a=pm.response.json();",
                  "pm.test('Solo devuelve productos con stock <= 5',()=>{",
                  "  pm.expect(a).to.be.an('array');",
                  "  a.forEach(p=>{pm.expect(p.stock).to.be.at.most(5);pm.expect(p.stockBajo).to.eql(true);});",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "04 Listado de pedidos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/pedidos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pedidos"
              ]
            },
            "description": "Lista los pedidos y captura dinámicamente un ID existente y otro inexistente."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const pedidos = pm.response.json();",
                  "pm.test('Respuesta es una lista de pedidos', () => {",
                  "  pm.expect(pedidos).to.be.an('array');",
                  "  pedidos.forEach(p => pm.expect(p).to.include.all.keys('id','direccion','metodoPago','subtotal','envio','total','fechaCreacion','detalles'));",
                  "});",
                  "if (pedidos.length) {",
                  "  pm.collectionVariables.set('pedidoId', String(pedidos[0].id));",
                  "  pm.collectionVariables.set('pedidoInexistenteId', String(Math.max(...pedidos.map(p => Number(p.id))) + 1000000));",
                  "} else {",
                  "  pm.collectionVariables.unset('pedidoId');",
                  "  pm.collectionVariables.set('pedidoInexistenteId', String(Date.now()));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "05 Consulta de pedido por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/pedidos/{{pedidoId}}",
