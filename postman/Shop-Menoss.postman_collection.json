            "body": {
              "mode": "raw",
              "raw": "{\n  \"direccion\": \"Av. Pruebas 123, Lima\",\n  \"referencia\": \"Cantidad inválida\",\n  \"metodoPago\": \"EFECTIVO\",\n  \"detalles\": [\n    {\n      \"productoId\": 0,\n      \"cantidad\": 0\n    }\n  ]\n}",
